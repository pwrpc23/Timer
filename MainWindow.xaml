<Window x:Class="Timer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:Timer"
        mc:Ignorable="d"
        Title="Sayaç" Height="167" Width="264" ResizeMode="NoResize">
	<StackPanel Margin="10">
		<TextBlock Text="Dakika:" />
		<xctk:IntegerUpDown x:Name="MinutesUpDown" Minimum="0" Maximum="59" Value="0" Width="80"/>

		<TextBlock Text="Saniye:" />
		<xctk:IntegerUpDown x:Name="SecondsUpDown" Minimum="0" Maximum="59" Value="0" Width="80"/>

		<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
			<Button Content="Başlat" Click="Start_Click" Margin="5"/>
			<Button Content="Durdur" Click="Pause_Click" Margin="5"/>
			<Button Content="Devam" Click="Resume_Click" Margin="5"/>
			<Button Content="Sıfırla" Click="Reset_Click" Margin="5"/>
			<Button Content="Kapat" Click="CloseDisplay_Click" Margin="5"/>
		</StackPanel>
	</StackPanel>
</Window>
